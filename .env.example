GROQ_API_KEY=""
GOOGLE_API_KEY=""

# Switch between "groq" or "gemini"
LLM_PROVIDER="gemini"

# Retry & fallback settings (used when LLM_PROVIDER=gemini)
LLM_MAX_RETRIES=3               # retries before giving up / falling back
GEMINI_FALLBACK_TO_GROQ=true    # auto-switch to Groq if Gemini keeps failing
TAVILY_API_KEY=""

# LangSmith Tracing Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="AI Travel Planner"
